# ROSA HCP benchmark — Makefile loads this file as `hcp.env` (one HCP cluster).

# Copy: cp hcp.env.example hcp.env   or   make init-env
#
# HCP lifecycle is Terraform-only (`clusters/hcp/terraform`; run via clusters/hcp/create.sh).
# RHCS_TOKEN: set explicitly or rely on rosa login (create.sh runs `rosa token` when unset).

# ROSA_HCP_TERRAFORM_VAR_FILE=/abs/path/terraform.tfvars  # skip auto-generated tfvars
# ROSA_HCP_INSTANCE_TYPE=m5.xlarge

# Terraform apply retries when OCM returns CLUSTERS-MGMT-403 (transient race on concurrent mutations).
# Tuned in clusters/hcp/lib-terraform.sh via hcp_terraform_apply_retry_on_ocm_403.
# ROSA_HCP_TERRAFORM_403_MAX_RETRIES=12
# ROSA_HCP_TERRAFORM_403_RETRY_SLEEP_SEC=120

# Multi-AZ HCP: three default pools (workers-0/1/2). Replica fields are per AZ —
# 1 min / 3 max per AZ ⇒ 3–9 workers cluster-wide. Separate from AUTOSCALE_* (benchmark pools).
ROSA_HCP_MULTI_AZ=yes
ROSA_HCP_REPLICAS=1
ROSA_HCP_MAX_POOL_REPLICAS=3

ROSA_CLUSTER_NAME_HCP=hcp-bench

AWS_REGION=us-east-1
# Same value required in `classic.env` — keep benchmarks aligned for Classic vs HCP.
ROSA_VERSION=4.21.12

AUTOSCALE_MIN_REPLICAS=1
AUTOSCALE_MAX_REPLICAS=10

CLUSTER_ADMIN_PASSWORD=Passw0rd12345!

# Vpc CIDR maps into generated Terraform varfile (`clusters/hcp/lib-terraform.sh`).
ROSA_HCP_NETWORK_VPC_CIDR=10.0.0.0/16

# `make destroy-hcp` only — skip refresh during terraform destroy (partial/interrupted teardown).
# ROSA_HCP_TERRAFORM_DESTROY_NO_REFRESH=1

