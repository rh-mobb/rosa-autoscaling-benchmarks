# ROSA HCP AutoNode benchmark — copy to autonode.env or run: make init-env
#
# AutoNode (Karpenter) is a Private Preview feature. Prerequisites:
#   1. Enrolled in the AutoNode Private Preview program
#   2. ROSA CLI v1.2.57 or above
#   3. Cluster must be in us-east-1 (private preview restriction)
#   4. OpenShift version 4.19 or above
#
# Lifecycle:  make create-hcp-autonode   (provisions cluster + enables AutoNode)
#             make destroy-hcp-autonode  (cleans Karpenter resources, then destroys)

# Region is fixed to us-east-1 for the AutoNode private preview.
AWS_REGION=us-east-1

# Max 12 chars: the longest ROSA HCP operator role suffix is 52 chars, pushing
# 14-char names like 'autonode-bench' over IAM's 64-char role-name limit.
ROSA_CLUSTER_NAME_AUTONODE=an-bench

# Must be 4.19 or above for AutoNode.
ROSA_VERSION=4.19.15

CLUSTER_ADMIN_PASSWORD=Passw0rd12345!

# ── Terraform knobs (same as hcp.env) ─────────────────────────────────────────
# Use a distinct VPC CIDR from hcp-bench to allow both stacks to coexist.
ROSA_HCP_NETWORK_VPC_CIDR=10.1.0.0/16

# AutoNode clusters use Karpenter for scaling — do NOT enable multi-AZ machine
# pools or autoscaling on the default pool. The AutoNode shard returns 403 on
# machine pool autoscaling updates (Karpenter owns that responsibility).
# Single AZ, fixed 2 replicas matches the validated reference setup.
ROSA_HCP_MULTI_AZ=no
ROSA_HCP_REPLICAS=2
# ROSA_HCP_MAX_POOL_REPLICAS must equal ROSA_HCP_REPLICAS for AutoNode clusters.
# The AutoNode shard returns 403 when Terraform tries to configure autoscaling
# (min < max) on the default workers pool — Karpenter owns scaling responsibility.
ROSA_HCP_MAX_POOL_REPLICAS=2

# ROSA_HCP_INSTANCE_TYPE=m5.xlarge

# Terraform apply OCM-403 retry tuning (same as hcp.env; defaults are usually fine).
# ROSA_HCP_TERRAFORM_403_MAX_RETRIES=12
# ROSA_HCP_TERRAFORM_403_RETRY_SLEEP_SEC=120

# ── AutoNode settings ─────────────────────────────────────────────────────────
# IAM resource prefix for the Karpenter controller role and policy.
# Must be unique per AWS account — change if you already have an 'autonode' prefix.
AUTONODE_PREFIX=autonode

# Provision shard that has AutoNode enabled. Change only if Red Hat directs you to.
AUTONODE_SHARD_ID=9f11dd2b-98c1-11f0-8fe5-0a580a830a08

# ── Teardown ──────────────────────────────────────────────────────────────────
# `make destroy-hcp-autonode` only — skip Terraform refresh on partial/interrupted teardown.
# ROSA_HCP_TERRAFORM_DESTROY_NO_REFRESH=1
