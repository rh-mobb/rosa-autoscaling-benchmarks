# ROSA Classic benchmark — Makefile loads this file as `classic.env` (one Classic cluster).

# Copy: cp classic.env.example classic.env   or   make init-env
#
# Authenticate separately:
#   rosa login
#   aws configure   (or use AWS_PROFILE / instance role)

ROSA_CLUSTER_NAME_CLASSIC=classic-bench

AWS_REGION=us-east-1
# Same value required in `hcp.env` (Makefile loads hcp.env last; blank there overrides classic).
ROSA_VERSION=4.21.12

# Multi-AZ + worker autoscaling (min/max; ROSA does not take a fixed replica count with autoscaling).
ROSA_CLASSIC_MULTI_AZ=yes
ROSA_CLASSIC_COMPUTE_MIN_REPLICAS=3
ROSA_CLASSIC_COMPUTE_MAX_REPLICAS=9

# Shared benchmark defaults (hcp.env can omit duplicates; values in hcp.env win on conflict)
AUTOSCALE_MIN_REPLICAS=1
AUTOSCALE_MAX_REPLICAS=10

# Optional — follow-up benchmark machine pools on a *multi-AZ* Classic cluster without 3× nodes per pool:
# one subnet, one machine each (lighter on quota/capacity than default multi-AZ pools).
# ROSA_MACHINE_POOL_SINGLE_AZ=yes
# ROSA_MACHINE_POOL_AZ=us-east-1a
# ROSA_MACHINE_POOL_MIN_REPLICAS=1
# ROSA_MACHINE_POOL_MAX_REPLICAS=1

# SECURITY: treat like any credential — do not commit *.env (only *.env.example)
CLUSTER_ADMIN_PASSWORD=Passw0rd12345!
